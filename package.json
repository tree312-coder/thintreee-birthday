{
  "name": "thintreee-birthday-collection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ThinTreé — Thiên Trí's private birthday collection",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/bootstrap.ts && node --disable-warning=ExperimentalWarning --experimental-strip-types server/index.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning --experimental-strip-types server/index.ts",
    "setup": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/setup.ts",
    "owner:setup": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/owner-setup.ts",
    "build:client": "tsc -p tsconfig.client.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build:client && npm test"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
